# Ports: backend and Vite dev server
WG_PORT=8100
WG_WEB_PORT=5170
# Database file and the marker file used by pause faults
WG_DB_PATH=var/wg.db
WG_FAULT_WAIT_FILE=var/fault.wait
# 1 enables /sim routes, the demo role and API docs
WG_DEMO_MODE=0
# Random secrets, generated per working copy; the backend refuses to start without the first two
WG_CODE_HMAC_KEY=
WG_SESSION_SECRET=
WG_CHANNEL_SECRET=
# Language model: deepseek or stub; the key stays on the backend
WG_LLM_PROVIDER=stub
WG_LLM_API_KEY=
WG_LLM_BASE_URL=https://api.deepseek.com
WG_LLM_MODEL=deepseek-flash
WG_LLM_THINKING=disabled
WG_LLM_TIMEOUT_S=30
WG_LLM_STUB_SCRIPT=
# Spend guard: CNY per 1M tokens as hit/miss/out, and the cap in CNY
WG_LLM_PRICE_TABLE=0.04/2/8
WG_LLM_SPEND_CAP_CNY=50
# Proxy for the application's own outbound calls only
WG_OUTBOUND_PROXY=
# IM adapter
WG_FEISHU_APP_ID=
WG_FEISHU_APP_SECRET=
WG_BACKEND_URL=http://127.0.0.1:8100
# Base of links to trusted cards sent over IM
WG_WEB_BASE_URL=http://127.0.0.1:8100
